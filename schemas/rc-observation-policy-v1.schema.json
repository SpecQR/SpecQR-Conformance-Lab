{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecQR RC observation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "candidate",
    "distTags",
    "technicalEvidence",
    "repositories",
    "timeline",
    "consumerConfirmation",
    "blockingCategories",
    "statusRules",
    "nonClaims"
  ],
  "properties": {
    "$schema": { "const": "../schemas/rc-observation-policy-v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "specqr-rc-observation-policy" },
    "id": { "const": "specqr-3.0.0-rc.2-observation-v1" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactRequested",
        "nextRequested",
        "resolvedVersion",
        "publishedAt",
        "tarballSha256",
        "expandedSha256",
        "manifestSha256",
        "fileCount",
        "runtimeDependencyCount"
      ],
      "properties": {
        "exactRequested": { "const": "specqr@3.0.0-rc.2" },
        "nextRequested": { "const": "specqr@next" },
        "resolvedVersion": { "const": "3.0.0-rc.2" },
        "publishedAt": { "const": "2026-08-02T07:38:47.138Z" },
        "tarballSha256": { "$ref": "#/$defs/sha256" },
        "expandedSha256": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "fileCount": { "const": 121 },
        "runtimeDependencyCount": { "const": 0 }
      }
    },
    "distTags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest", "next"],
      "properties": {
        "latest": { "const": "2.4.0" },
        "next": { "const": "3.0.0-rc.2" }
      }
    },
    "technicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflowId",
        "initialRunId",
        "initialHeadSha",
        "initialArtifactId",
        "initialArtifactName",
        "initialArtifactSha256",
        "initialReadinessSha256",
        "initialReadinessArtifactSetSha256",
        "requiredNodeMajors",
        "requiredV3ContractChecks"
      ],
      "properties": {
        "repository": { "const": "SpecQR/SpecQR-Conformance-Lab" },
        "workflowId": { "type": "integer", "minimum": 1 },
        "initialRunId": { "type": "integer", "minimum": 1 },
        "initialHeadSha": { "$ref": "#/$defs/commit" },
        "initialArtifactId": { "type": "integer", "minimum": 1 },
        "initialArtifactName": { "type": "string", "minLength": 1 },
        "initialArtifactSha256": { "$ref": "#/$defs/sha256" },
        "initialReadinessSha256": { "$ref": "#/$defs/sha256" },
        "initialReadinessArtifactSetSha256": { "$ref": "#/$defs/sha256" },
        "requiredNodeMajors": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["18", "20", "22", "24"] }
        },
        "requiredV3ContractChecks": { "const": 35 }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["SpecQR/SpecQR", "SpecQR/SpecQR-Conformance-Lab"] }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAgeHours", "minimumSnapshots", "minimumFinalGapHours", "milestones"],
      "properties": {
        "minimumAgeHours": { "const": 168 },
        "minimumSnapshots": { "const": 3 },
        "minimumFinalGapHours": { "const": 48 },
        "milestones": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "minimumAgeHours"],
            "properties": {
              "id": { "enum": ["initial", "after-72-hours", "after-168-hours"] },
              "minimumAgeHours": { "type": "number", "minimum": 0 },
              "maximumAgeHours": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "consumerConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumIndependentConfirmations", "requiredPackageSource", "allowedKinds", "requiredEvidence"],
      "properties": {
        "minimumIndependentConfirmations": { "const": 1 },
        "requiredPackageSource": { "const": "npm-registry" },
        "allowedKinds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["independent-project", "independent-sample"] }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["url", "commit", "logUrl", "logSha256"] }
        }
      }
    },
    "blockingCategories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["defect", "regression", "security", "migration-failure"] }
    },
    "statusRules": {
      "type": "object",
      "required": ["pendingWhen", "blockedWhen", "sufficientWhen"],
      "properties": {
        "pendingWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "blockedWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sufficientWhen": { "const": "all-criteria-pass" }
      }
    },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
