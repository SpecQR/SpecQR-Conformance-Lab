{
  "version": 1,
  "id": "reference-nayuki",
  "name": "Nayuki fixed matrix reference vectors",
  "description": "固定 Version/ECC/mask と明示的 segmentation で live Nayuki 1.8.0 と matrix exact match を確認。全 ECC×mask、Version 7 geometry、9/10・26/27 count-width 境界、Version 40 byte capacity を含む。",
  "category": "reference-matrix",
  "vectors": [
    {
      "id": "reference.nayuki.numeric.v1-l-mask0",
      "title": "Numeric fixed Version 1-L mask 0",
      "category": "reference-matrix",
      "operation": "generate",
      "input": {
        "text": "01234567"
      },
      "options": {
        "version": 1,
        "errorCorrectionLevel": "L",
        "maskPattern": 0,
        "mode": "numeric"
      },
      "expect": {
        "referenceMatrix": {
          "adapter": "nayuki",
          "exact": true,
          "scope": "fixed-version-ecc-mask"
        }
      },
      "tags": [
        "nayuki",
        "reference-matrix",
        "numeric",
        "all-ecc-masks"
      ]
    },
