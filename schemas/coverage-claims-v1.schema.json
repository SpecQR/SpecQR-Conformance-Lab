{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specqr.github.io/SpecQR-Conformance-Lab/schemas/coverage-claims-v1.schema.json",
  "title": "SpecQR Conformance Lab Coverage Claims v1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "target", "claims", "nonClaims"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "description": "Versioned evidence contract evaluated against every applicable source vector in the claim's suites. Required checks must exist and pass; report-declared status or optionality cannot reduce these requirements.",
      "required": ["adapterId", "capability"],
      "additionalProperties": false,
      "properties": {
        "adapterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "capability": {
          "type": "string",
          "enum": ["specqr-expectations-v1", "jsqr-text-binary-v1", "nayuki-fixed-matrix-v1", "optional-cli-text-v1"],
          "description": "specqr-expectations-v1 requires all SpecQR-owned expect fields (rejects, matrixHash, diagnostics.subset, planning, gs1, structuredAppend, validation, render and package checks). jsqr-text-binary-v1 requires each decode.text/binaryHex check on generate/generateSegments. nayuki-fixed-matrix-v1 requires referenceMatrix.exact for every Nayuki expectation. optional-cli-text-v1 requires decode.text on generate/generateSegments unless the optional CLI command is explicitly unavailable; raw-byte and metadata coverage are outside this capability."
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["package", "requested", "source"],
      "additionalProperties": true,
      "properties": {
        "package": {
          "const": "specqr"
        },
        "requested": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "summary",
        "suites",
        "adapters",
        "evidenceRequirements",
        "badges",
        "reportSummaryKey",
        "limits"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": ["verified", "partial", "not-claimed"]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "suites": {
          "$ref": "#/$defs/stringArray"
        },
        "adapters": {
          "$ref": "#/$defs/stringArray"
        },
        "evidenceRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "badges": {
          "$ref": "#/$defs/stringArray"
        },
        "reportSummaryKey": {
          "$ref": "#/$defs/nullableString"
        },
        "limits": {
          "$ref": "#/$defs/stringArray"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "futureDirection": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publicDocs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
