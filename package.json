{
  "name": "@specqr/conformance-lab",
  "version": "0.1.0",
  "private": true,
  "description": "External conformance, comparison, and report infrastructure for SpecQR.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/SpecQR/SpecQR-Conformance-Lab#readme",
  "bugs": {
    "url": "https://github.com/SpecQR/SpecQR-Conformance-Lab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpecQR/SpecQR-Conformance-Lab.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tools/test.js && node tools/test-rc.js",
    "validate:vectors": "node tools/validate-vectors.js",
    "conformance": "node tools/run-conformance.js",
    "report": "node tools/report.js",
    "verify:report": "node tools/verify-report.js",
    "verify:claims": "node tools/verify-coverage-claims.js",
    "verify:target": "node tools/verify-specqr-target.js",
    "validate:schemas": "node tools/validate-schemas.js",
    "compare:reports": "node tools/compare-reports.js",
    "summary": "node tools/write-github-summary.js",
    "verify:links": "node tools/verify-links.js",
    "rc:package-surface": "node tools/run-rc-package-surface.js",
    "rc:full": "node tools/run-rc-full.js",
    "rc:assemble": "node tools/assemble-rc-readiness.js",
    "rc:validate": "node tools/validate-rc-readiness.js",
    "pages:build": "npm run conformance && npm run report && node tools/build-pages.js",
    "verify": "npm run validate:vectors && npm test && npm run conformance && npm run report && npm run verify:claims && npm run validate:schemas && npm run verify:report && npm run verify:links"
  },
  "keywords": [
    "specqr",
    "qr",
    "qrcode",
    "conformance",
    "vectors"
  ],
  "devDependencies": {
    "@types/node": "25.9.1",
    "jsqr": "1.4.0",
    "nayuki-qr-code-generator": "1.8.0",
    "specqr": "2.4.0",
    "typescript": "6.0.3"
  }
}
